# Apache: serve the SPA for every route so deep links (e.g. /products/tea-shop) don't 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files and directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else → the app shell
  RewriteRule ^ index.html [L]
</IfModule>

# Long-cache hashed build assets and images; always revalidate the HTML shell
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|png|jpe?g|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
